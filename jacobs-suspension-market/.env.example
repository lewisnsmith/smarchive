# ---------------------------------------------------------------- rpc + keys
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# Use a throwaway key funded with only what you intend to risk.
PRIVATE_KEY=

# ------------------------------------------------------------------ addresses
# Native USDC on Base. Verify before use.
COLLATERAL=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Do NOT hardcode this from memory. Derive it from the UMA Finder:
#   make oracle-info
OOV3=

# ------------------------------------------------------------------- question
# THE AUTHORITATIVE CUTOFF. Packers Week 1 kickoff, at Minnesota:
#   Sunday 2026-09-13, 3:25 p.m. CT = 20:25 UTC
# Per the rules text, this timestamp does not move even if the game does.
RESOLUTION_TIMESTAMP=1789331100

# Seconds an assertion sits undisputed before it can settle. UMA's default is
# short; 24-48h gives humans time to notice a wrong assertion.
ASSERTION_LIVENESS=86400

# After this, if nothing is pending, anyone can settle the market to NO.
# Must be > RESOLUTION_TIMESTAMP + ASSERTION_LIVENESS. Below is cutoff + 30d
# (2026-10-13T20:25:00Z).
FALLBACK_DEADLINE=1791923100
